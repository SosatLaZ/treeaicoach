<Bindings>
	<!-- « Mode rafale » de l'HV : une touche = la prochaine action sûre (une action protégée par appui). Sans touche par défaut. -->
	<Binding name="TREEAI_AH_NEXT" header="TREEAI" category="ADDONS">
		if TreeAI and TreeAI.AuctionNext then TreeAI.AuctionNext() end
	</Binding>
	<!-- (4.1) Boutons rapides (Shortcuts.lua) : une touche par bouton + « mode suivant ». Sans touche par défaut ;
	     « Raccourcis conseillés » (options des boutons rapides) pose Alt-1… sur les seules touches libres. -->
	<Binding name="TREEAI_QB_TURNIN" header="TREEAI" category="ADDONS">
		if TreeAI and TreeAI.StripAction then TreeAI.StripAction("rendre") end
	</Binding>
	<Binding name="TREEAI_QB_PICKUP" header="TREEAI" category="ADDONS">
		if TreeAI and TreeAI.StripAction then TreeAI.StripAction("prendre") end
	</Binding>
	<Binding name="TREEAI_STRIP_SUIVANT" header="TREEAI" category="ADDONS">
		if TreeAI and TreeAI.StripAction then TreeAI.StripAction("suivant") end
	</Binding>
	<Binding name="TREEAI_QB_ZONE" header="TREEAI" category="ADDONS">
		if TreeAI and TreeAI.StripAction then TreeAI.StripAction("zone") end
	</Binding>
	<Binding name="TREEAI_QB_GROUP" header="TREEAI" category="ADDONS">
		if TreeAI and TreeAI.StripAction then TreeAI.StripAction("groupe") end
	</Binding>
	<Binding name="TREEAI_STRIP_JOURNAL" header="TREEAI" category="ADDONS">
		if TreeAI and TreeAI.StripAction then TreeAI.StripAction("journal") end
	</Binding>
	<Binding name="TREEAI_MODE_NEXT" header="TREEAI" category="ADDONS">
		if TreeAI and TreeAI.StripAction then TreeAI.StripAction("mode") end
	</Binding>
	<!-- (5.0) Actions rapides : une liaison par bouton de la bande + « action suivante » + la pastille « Guidage
	     quêtes ». Sans touche par défaut ; « Touches conseillées » pose Alt-1… sur les seules touches libres. -->
	<Binding name="TREEAI_QB_FASTLVL" header="TREEAI" category="ADDONS">
		if TreeAI and TreeAI.StripAction then TreeAI.StripAction("vite") end
	</Binding>
	<Binding name="TREEAI_STRIP_SACS" header="TREEAI" category="ADDONS">
		if TreeAI and TreeAI.StripAction then TreeAI.StripAction("sacs") end
	</Binding>
	<Binding name="TREEAI_STRIP_EQUIP" header="TREEAI" category="ADDONS">
		if TreeAI and TreeAI.StripAction then TreeAI.StripAction("equip") end
	</Binding>
	<Binding name="TREEAI_GUIDE_TOGGLE" header="TREEAI" category="ADDONS">
		if TreeAI and TreeAI.StripAction then TreeAI.StripAction("guide") end
	</Binding>
	<Binding name="TREEAI_ACTION_NEXT" header="TREEAI" category="ADDONS">
		if TreeAI and TreeAI.StripAction then TreeAI.StripAction("next") end
	</Binding>
	<!-- (4.2) Métiers : la session métier (bouton « Métiers » de la bande). Sans touche par défaut. -->
	<Binding name="TREEAI_STRIP_METIERS" header="TREEAI" category="ADDONS">
		if TreeAI and TreeAI.StripAction then TreeAI.StripAction("metiers") end
	</Binding>
	<!-- La fenêtre TreeAI (Maintenant, Quêtes, Trajet, Donjons, Options). Sans touche par défaut. -->
	<Binding name="TREEAI_MAIN" header="TREEAI" category="ADDONS">
		if TreeAI and TreeAI.ToggleMain then TreeAI.ToggleMain() end
	</Binding>
	<!-- Raccourcis (boutons sécurisés de TreeAI : l'action part de TA touche, comme un clic). Sans touche par défaut. -->
	<!-- (4.1) Courses en ville / session métier : étape suivante / précédente (la boussole suit). Sans touche par défaut. -->
	<Binding name="TREEAI_STEP_NEXT" header="TREEAI" category="ADDONS">
		if TreeAI and TreeAI.FocusStep then TreeAI.FocusStep(1) end
	</Binding>
	<Binding name="TREEAI_STEP_PREV" header="TREEAI" category="ADDONS">
		if TreeAI and TreeAI.FocusStep then TreeAI.FocusStep(-1) end
	</Binding>
	<Binding name="CLICK TreeAIQuickItem:LeftButton" header="TREEAI" category="ADDONS"/>
	<Binding name="CLICK TreeAIQuickTarget:LeftButton" header="TREEAI" category="ADDONS"/>
	<Binding name="CLICK TreeAIQuickMount:LeftButton" header="TREEAI" category="ADDONS"/>
	<Binding name="CLICK TreeAIQuickHearth:LeftButton" header="TREEAI" category="ADDONS"/>
	<Binding name="CLICK TreeAIQuick_pull:LeftButton" header="TREEAI" category="ADDONS"/>
	<Binding name="CLICK TreeAIQuick_pet:LeftButton" header="TREEAI" category="ADDONS"/>
	<Binding name="CLICK TreeAIQuick_mend:LeftButton" header="TREEAI" category="ADDONS"/>
	<Binding name="CLICK TreeAIQuick_eat:LeftButton" header="TREEAI" category="ADDONS"/>
	<Binding name="CLICK TreeAIQuick_bandage:LeftButton" header="TREEAI" category="ADDONS"/>
</Bindings>
