<Bindings>
	<!-- « Mode rafale » de l'HV : une touche = la prochaine action sûre (une action protégée par appui). Sans touche par défaut. -->
	<Binding name="TREEAI_AH_NEXT" header="TREEAI" category="ADDONS">
		if TreeAI and TreeAI.AuctionNext then TreeAI.AuctionNext() end
	</Binding>
	<!-- La fenêtre TreeAI (Maintenant, Quêtes, Trajet, Donjons, Options). Sans touche par défaut. -->
	<Binding name="TREEAI_MAIN" header="TREEAI" category="ADDONS">
		if TreeAI and TreeAI.ToggleMain then TreeAI.ToggleMain() end
	</Binding>
	<!-- Raccourcis (boutons sécurisés de TreeAI : l'action part de TA touche, comme un clic). Sans touche par défaut. -->
	<!-- (4.1) Courses en ville / session métier : étape suivante / précédente (la boussole suit). Sans touche par défaut. -->
	<Binding name="TREEAI_STEP_NEXT" header="TREEAI" category="ADDONS">
		if TreeAI and TreeAI.FocusStep then TreeAI.FocusStep(1) end
	</Binding>
	<Binding name="TREEAI_STEP_PREV" header="TREEAI" category="ADDONS">
		if TreeAI and TreeAI.FocusStep then TreeAI.FocusStep(-1) end
	</Binding>
	<Binding name="CLICK TreeAIQuickItem:LeftButton" header="TREEAI" category="ADDONS"/>
	<Binding name="CLICK TreeAIQuickTarget:LeftButton" header="TREEAI" category="ADDONS"/>
	<Binding name="CLICK TreeAIQuickMount:LeftButton" header="TREEAI" category="ADDONS"/>
	<Binding name="CLICK TreeAIQuickHearth:LeftButton" header="TREEAI" category="ADDONS"/>
	<Binding name="CLICK TreeAIQuick_pull:LeftButton" header="TREEAI" category="ADDONS"/>
	<Binding name="CLICK TreeAIQuick_pet:LeftButton" header="TREEAI" category="ADDONS"/>
	<Binding name="CLICK TreeAIQuick_mend:LeftButton" header="TREEAI" category="ADDONS"/>
	<Binding name="CLICK TreeAIQuick_eat:LeftButton" header="TREEAI" category="ADDONS"/>
	<Binding name="CLICK TreeAIQuick_bandage:LeftButton" header="TREEAI" category="ADDONS"/>
</Bindings>
